# FastAPI origin. This value is read only by Next.js server routes.
API_BASE_URL=http://localhost:8000

# Optional backend route overrides (paths only, not full URLs).
API_AUTH_LOGIN_PATH=/auth/login
API_AUTH_REGISTER_PATH=/auth/register

# HttpOnly session cookie settings.
AUTH_COOKIE_NAME=sentiboard_session
AUTH_COOKIE_MAX_AGE_SECONDS=604800

# Client-side validation settings.
NEXT_PUBLIC_USERNAME_MIN_LENGTH=3
NEXT_PUBLIC_USERNAME_MAX_LENGTH=50
NEXT_PUBLIC_PASSWORD_MIN_LENGTH=8
NEXT_PUBLIC_PASSWORD_REQUIRE_UPPERCASE=true
NEXT_PUBLIC_PASSWORD_REQUIRE_NUMBER=true
NEXT_PUBLIC_PASSWORD_REQUIRE_SPECIAL=false
